# RDGen Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: GitHub Configuration
# =============================================================================

# GitHub Personal Access Token with 'repo' and 'workflow' permissions
# Create at: https://github.com/settings/tokens
# Required scopes: repo (full), workflow
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub repository owner (username or organization)
GITHUB_OWNER=your-github-username

# GitHub repository name (where you forked/copied rdgen workflows)
GITHUB_REPO=rdgen

# =============================================================================
# Server Configuration
# =============================================================================

# Port to run the application on (default: 5000)
PORT=5000

# Public URL where this server is accessible (for GitHub Actions callbacks)
# IMPORTANT: Must be accessible from the internet if using real builds
GEN_URL=https://rdgen.nextcoreti.com.br

# =============================================================================
# Optional Settings
# =============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Node environment (development, production)
NODE_ENV=production

# =============================================================================
# Code Signing (Optional)
# =============================================================================

# If you have code signing set up, add these:
# SIGN_BASE_URL=https://your-signing-server.com
# SIGN_API_KEY=your-signing-api-key

# =============================================================================
# Client Profile Encryption (REQUIRED)
# =============================================================================

# AES-256 master key for encrypting client profiles (32 bytes in hex = 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLIENT_PROFILE_KEY=your-64-char-hex-key-here

# =============================================================================
# Admin User (created on first startup)
# =============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Administrador
