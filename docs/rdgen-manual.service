[Unit]
Description=RDGen Backend - RustDesk Custom Client Generator API
Documentation=https://github.com/bryangerlach/rdgen
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/rdgen/rdgen-real/backend
EnvironmentFile=/opt/rdgen/rdgen-real/.env
ExecStart=/usr/bin/node dist/index.js

# Restart policy
Restart=always
RestartSec=10

# Environment
Environment=NODE_ENV=production
Environment=PORT=4000

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rdgen-backend

[Install]
WantedBy=multi-user.target
